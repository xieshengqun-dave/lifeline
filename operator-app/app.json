{
  "expo": {
    "name": "Lifeline Operator",
    "slug": "lifeline-operator",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "lifeline-operator",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lifeline.operator"
    },
    "android": {
      "package": "com.lifeline.operator",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#004d60",
        "backgroundImage": "./assets/adaptive-icon-background.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 170,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-font"
    ],
    "extra": {
      "apiBaseUrl": "http://192.168.1.203:4000",
      "eas": {
        "projectId": "1227fb20-3212-4f48-9a36-4c3dd5f82027"
      }
    }
  }
}
